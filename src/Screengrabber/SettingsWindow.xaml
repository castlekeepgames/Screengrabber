<Window x:Class="Screengrabber.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screengrabber Settings"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ThemeMode="System"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="HotkeyBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="False" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Click, then press the new key combination" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,6,24,20">
        <TextBlock Style="{StaticResource Section}" Text="Hotkeys" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Capture" />
                <TextBlock Style="{StaticResource Note}" Text="Snip → whole screen → copy path → new snip" />
            </StackPanel>
            <TextBox x:Name="CaptureHotkeyBox" Grid.Column="1" Style="{StaticResource HotkeyBox}" />

            <StackPanel Grid.Row="2" VerticalAlignment="Center">
                <TextBlock Text="Share" />
                <TextBlock Style="{StaticResource Note}" Text="Only active while the post-capture panel is showing" />
            </StackPanel>
            <TextBox x:Name="ShareHotkeyBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource HotkeyBox}" />
        </Grid>
        <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0"
                   Text="Click a box, then press the new combination. If nothing happens, another app already uses that combination. Hotkeys are paused while this window is open." />

        <TextBlock Style="{StaticResource Section}" Text="Saving" />
        <DockPanel>
            <Button x:Name="DefaultFolderButton" DockPanel.Dock="Right" Content="Default" Margin="6,0,0,0" />
            <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" />
            <TextBox x:Name="FolderBox" />
        </DockPanel>
        <CheckBox x:Name="CopyImageCheck" Margin="0,10,0,0" Content="Copy the image to the clipboard after each capture" />

        <TextBlock Style="{StaticResource Section}" Text="Panel" />
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Close the post-capture panel after" VerticalAlignment="Center" />
            <TextBox x:Name="TimeoutBox" Width="64" Margin="8,0" TextAlignment="Center" />
            <TextBlock Text="seconds" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Style="{StaticResource Section}" Text="Startup" />
        <CheckBox x:Name="StartWithWindowsCheck" Content="Start Screengrabber when Windows starts" />

        <TextBlock Style="{StaticResource Section}" Text="Share targets" />
        <DockPanel>
            <Button x:Name="EditTargetsButton" DockPanel.Dock="Right" Content="Edit share targets…" Margin="12,0,0,0"
                    VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource Note}" VerticalAlignment="Center"
                       Text="Slack, Email, Claude Code, Grok Bot and Codex are set in settings.json. Changes apply the next time you share." />
        </DockPanel>

        <TextBlock x:Name="ErrorText" Foreground="#FFDC2626" TextWrapping="Wrap" Margin="0,16,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="SaveButton" Content="Save" IsDefault="True" MinWidth="88" Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Cancel" IsCancel="True" MinWidth="88" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
