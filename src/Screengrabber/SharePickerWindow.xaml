<Window x:Class="Screengrabber.SharePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Share screenshot"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="TargetButton" TargetType="Button">
            <Setter Property="Width" Value="112" />
            <Setter Property="Height" Value="92" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" CornerRadius="8" Background="#FF374151" BorderBrush="#FF4B5563" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#FF2563EB" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#FF3B82F6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Card" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 12px transparent margin leaves room for the shadow. -->
    <Grid Margin="12">
        <Border CornerRadius="12" Background="#FF1F2937">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="12" Background="#FA1F2937" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="14,12,14,14">
            <StackPanel>
                <DockPanel Margin="4,0,4,10">
                    <TextBlock DockPanel.Dock="Right" Text="Esc to cancel" Foreground="#FF9CA3AF" FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Share to…" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,0,10,0"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="FileName" Foreground="#FF93C5FD" FontSize="12" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" MaxWidth="260" />
                </DockPanel>
                <ItemsControl x:Name="Targets">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="Status" Foreground="#FFD1D5DB" FontSize="12" Margin="4,10,4,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
