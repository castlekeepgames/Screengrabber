<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Screengrabber</RootNamespace>
    <AssemblyName>Screengrabber</AssemblyName>
    <!-- WFO0003 suggests WinForms' SetHighDpiMode, but this is a WPF host: DPI awareness belongs in app.manifest. -->
    <!-- WPF0001: Window.ThemeMode (Fluent/Windows 11 look for the Settings window) is still marked experimental. -->
    <NoWarn>$(NoWarn);WFO0003;WPF0001</NoWarn>
    <!-- 64-bit, like most mail programs' MAPI DLLs. 32-bit-only ones (e.g. Mailbird) go through Screengrabber.MapiHelper. -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- A resident tray app: no background GC thread, and let the GC trade a little speed for a smaller heap. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationIcon>Screengrabber.ico</ApplicationIcon>
    <Version>1.3.0</Version>
    <Product>Screengrabber</Product>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <!-- Regenerate with tools/make-icon.ps1. Embedded too, for the tray icon. -->
    <EmbeddedResource Include="Screengrabber.ico" LogicalName="Screengrabber.Screengrabber.ico" />
  </ItemGroup>

  <!--
    Build the 32-bit MAPI helper as its own step (restore included) and ship it next to Screengrabber.exe.
    Not a ProjectReference: a win-x64 publish would restore the reference for win-x64, which a net48/x86 exe can't use.
  -->
  <PropertyGroup>
    <MapiHelperProject>$(MSBuildThisFileDirectory)..\Screengrabber.MapiHelper\Screengrabber.MapiHelper.csproj</MapiHelperProject>
  </PropertyGroup>

  <Target Name="BuildMapiHelper" AfterTargets="Build">
    <MSBuild Projects="$(MapiHelperProject)" Targets="Restore"
             Properties="Configuration=$(Configuration);MapiHelperRestore=$([System.Guid]::NewGuid())"
             RemoveProperties="RuntimeIdentifier;SelfContained;Platform;PublishDir;OutDir" />
    <MSBuild Projects="$(MapiHelperProject)" Targets="Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="RuntimeIdentifier;SelfContained;Platform;PublishDir;OutDir">
      <Output TaskParameter="TargetOutputs" ItemName="MapiHelperExe" />
    </MSBuild>
    <Copy SourceFiles="@(MapiHelperExe)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishMapiHelper" AfterTargets="Publish" DependsOnTargets="BuildMapiHelper">
    <Copy SourceFiles="@(MapiHelperExe)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
