<Window x:Class="Screengrabber.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add an app"
        Width="440"
        Height="520"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ThemeMode="System"
        UseLayoutRounding="True">
    <DockPanel Margin="20,16,20,20">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="0,0,0,10"
                   Text="Pick an app to share screenshots to. It'll come to the front, you open the chat or channel, point, and press the share key." />
        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,10" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="AddButton" Content="Add" IsDefault="True" MinWidth="88" IsEnabled="False"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="88" Margin="8,0,0,0" />
        </StackPanel>

        <Grid>
            <ListBox x:Name="AppList" DisplayMemberPath="Name" />
            <TextBlock x:Name="LoadingText" Text="Looking for your apps…" Opacity="0.7"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </DockPanel>
</Window>
