<Window x:Class="Screengrabber.ShareTargetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Share targets"
        Width="980"
        Height="520"
        MinWidth="760"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ThemeMode="System"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CellCombo" TargetType="ComboBox">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CellCheck" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="20,16,20,20">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="0,0,0,12">
            <Run Text="Each row is a button in the share picker; its number key is its position (up to 9)." />
            <LineBreak />
            <Run FontWeight="SemiBold" Text="Opens:" />
            <Run Text="an exe path, a URL, or shell:AppsFolder\&lt;AppID&gt;." />
            <Run FontWeight="SemiBold" Text="Window:" />
            <Run Text="the process to bring to the front if it's already running (e.g. slack). For Email, it's the mail app's process." />
        </TextBlock>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="OkButton" Content="OK" IsDefault="True" MinWidth="88" Style="{DynamicResource AccentButtonStyle}" />
                <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="88" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AddButton" Content="Add" MinWidth="72" />
                <Button x:Name="RemoveButton" Content="Remove" MinWidth="72" Margin="6,0,0,0" />
                <Button x:Name="UpButton" Content="Move up" MinWidth="72" Margin="18,0,0,0" />
                <Button x:Name="DownButton" Content="Move down" MinWidth="72" Margin="6,0,0,0" />
            </StackPanel>
        </DockPanel>

        <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" Foreground="#FFDC2626" TextWrapping="Wrap"
                   Margin="0,10,0,0" Visibility="Collapsed" />

        <DataGrid x:Name="Grid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="False"
                  SelectionMode="Single"
                  HeadersVisibility="All"
                  RowHeaderWidth="36"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Label}" ElementStyle="{StaticResource CellText}" Width="120" />
                <DataGridComboBoxColumn x:Name="MethodColumn" Header="Type" SelectedItemBinding="{Binding Method}" ElementStyle="{StaticResource CellCombo}" Width="90" />
                <DataGridComboBoxColumn x:Name="ClipboardColumn" Header="Copies" SelectedItemBinding="{Binding Clipboard}" ElementStyle="{StaticResource CellCombo}" Width="90" />
                <DataGridTextColumn Header="Opens" Binding="{Binding Launch}" ElementStyle="{StaticResource CellText}" Width="*" />
                <DataGridTextColumn Header="Window" Binding="{Binding FocusProcess}" ElementStyle="{StaticResource CellText}" Width="110" />
                <DataGridCheckBoxColumn Header="Auto-paste" Binding="{Binding AutoPaste}" ElementStyle="{StaticResource CellCheck}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
