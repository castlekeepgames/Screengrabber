<Window x:Class="Screengrabber.PostCapturePanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screengrabber"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        WindowStartupLocation="Manual"
        Width="324"
        SizeToContent="Height"
        UseLayoutRounding="True"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="KeyChip" TargetType="Border">
            <Setter Property="Background" Value="#FF374151" />
            <Setter Property="BorderBrush" Value="#FF4B5563" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFD1D5DB" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <!-- 12px transparent margin leaves room for the shadow. The shadow sits on its own layer so text stays crisp. -->
    <Grid Margin="12">
        <Border CornerRadius="10" Background="#FF1F2937">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="10" Background="#FA1F2937" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="12,10,12,12">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="CloseButton" DockPanel.Dock="Right" Text="✕" Foreground="#FF9CA3AF"
                               FontSize="12" Margin="8,0,0,0" Padding="4,0" Cursor="Hand"
                               VerticalAlignment="Center" ToolTip="Close" />
                    <TextBlock Text="✓" Foreground="#FF4ADE80" FontWeight="Bold" FontSize="14" Margin="0,0,6,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Saved" Foreground="White" FontWeight="SemiBold" FontSize="13" Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="FileName" Foreground="#FF93C5FD" FontSize="12" Cursor="Hand"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               ToolTip="Show in folder" />
                </DockPanel>

                <Border Margin="0,10" CornerRadius="6" Background="#FF111827" Cursor="Hand" ToolTip="Open image">
                    <Image x:Name="Thumbnail" MaxHeight="160" Stretch="Uniform" StretchDirection="DownOnly"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="4" />
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Style="{StaticResource KeyChip}">
                        <TextBlock x:Name="CaptureKeyText" Style="{StaticResource KeyText}" Text="Ctrl+`" />
                    </Border>
                    <TextBlock x:Name="CopyHint" Style="{StaticResource HintText}" Text="copy screenshot path" />
                </StackPanel>

                <StackPanel x:Name="ShareRow" Orientation="Horizontal" Background="Transparent" Cursor="Hand">
                    <Border Style="{StaticResource KeyChip}">
                        <TextBlock x:Name="ShareKeyText" Style="{StaticResource KeyText}" Text="Ctrl+Home" />
                    </Border>
                    <TextBlock Style="{StaticResource HintText}" Text="share" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
