<Window x:Class="Screengrabber.SnipOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screengrabber snip"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="Black"
        Cursor="Cross"
        UseLayoutRounding="True">
    <Grid x:Name="Root">
        <Image x:Name="Frozen" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />

        <!-- Dims everything outside the selection (even-odd fill punches the hole). -->
        <Path x:Name="Dim" Fill="#80000000" IsHitTestVisible="False" />

        <Canvas IsHitTestVisible="False">
            <Rectangle x:Name="SelectionBorder" Stroke="#FF3B82F6" StrokeThickness="1.5" Visibility="Collapsed" />
            <Border x:Name="SizeTag" Background="#E61F2937" CornerRadius="4" Padding="6,2" Visibility="Collapsed">
                <TextBlock x:Name="SizeText" Foreground="White" FontFamily="Segoe UI" FontSize="12" />
            </Border>
        </Canvas>

        <Border x:Name="Hint"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"
                Background="#E61F2937" CornerRadius="8" Padding="14,10"
                IsHitTestVisible="False">
            <StackPanel>
                <TextBlock x:Name="HintText" Foreground="White" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                           Text="Ctrl+` for whole screen" />
                <TextBlock Foreground="#FFB0B8C4" FontFamily="Segoe UI" FontSize="12" Margin="0,2,0,0"
                           Text="Drag to snip · Esc to cancel" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
