<Window x:Class="Screengrabber.DropGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screengrabber drop"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        WindowStartupLocation="Manual"
        Width="464"
        SizeToContent="Height"
        UseLayoutRounding="True"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="Step" TargetType="Border">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="#FF2563EB" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE5E7EB" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <!-- 12px transparent margin leaves room for the shadow. -->
    <Grid Margin="12">
        <Border CornerRadius="10" Background="#FF1F2937">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="10" Background="#FA1F2937" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="14,10,14,12">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock x:Name="CloseButton" DockPanel.Dock="Right" Text="✕" Foreground="#FF9CA3AF" FontSize="12"
                               Padding="4,0" Cursor="Hand" VerticalAlignment="Center" ToolTip="Cancel" />
                    <TextBlock x:Name="Heading" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>

                <DockPanel Margin="0,0,0,8">
                    <Border Style="{StaticResource Step}">
                        <TextBlock Text="1" Foreground="White" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="StepOne" Style="{StaticResource StepText}" />
                </DockPanel>

                <DockPanel>
                    <Border Style="{StaticResource Step}">
                        <TextBlock Text="2" Foreground="White" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Style="{StaticResource StepText}">
                        <Run Text="Point at it and press" />
                        <Border Background="#FF374151" BorderBrush="#FF4B5563" BorderThickness="1" CornerRadius="4" Padding="5,0"
                                Margin="2,0,0,-3">
                            <TextBlock x:Name="KeyText" Foreground="White" FontFamily="Consolas" FontSize="12" />
                        </Border>
                    </TextBlock>
                </DockPanel>

                <TextBlock x:Name="Problem" Foreground="#FFFBBF24" FontSize="12" TextWrapping="Wrap" Margin="30,10,0,0"
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
